{
  "name": "spytv-c2",
  "version": "1.0.6",
  "description": "SpyTV C2 desktop client — Authenticated, Inc.",
  "main": "main.js",
  "author": "Authenticated, Inc.",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.authenticated.spytv",
    "productName": "SpyTV C2",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "offline.html"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "SpyTV-C2-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "compression": "normal",
    "npmRebuild": false
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true
  }
}
