#!/usr/sbin/nft -f
# Generated by the SpyTV defensive toolkit — IoT VLAN isolation for 192.168.20.0/24
# Review carefully, then: nft -f this file && nft list ruleset
table inet iot_isolation
flush table inet iot_isolation

table inet iot_isolation {
    set approved_dns {
        type ipv4_addr
        elements = { 192.168.10.1, 1.1.1.1 }
    }

    chain forward {
        type filter hook forward priority 0; policy accept;

        # 1. Let replies to approved flows back in
        ct state established,related accept

        # 2. Explicit allows for the IoT/TV segment
        ip saddr 192.168.20.0/24 ip daddr @approved_dns udp dport 53 accept
        ip saddr 192.168.20.0/24 ip daddr @approved_dns tcp dport 53 accept
ip saddr 192.168.20.0/24 udp dport 123 accept
        ip saddr 192.168.20.0/24 tcp dport { 80, 443 } accept

        # 3. Block new IoT -> trusted LAN (the actual segmentation)
        ip saddr 192.168.20.0/24 ip daddr 192.168.10.0/24 counter log prefix "iot-to-lan-deny " drop

        # everything not matched above follows the chain policy
    }
}
