# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# C2 Data
c2_data/
logs/
certs/
*.log
# CVE update log lives at the repo root and IS tracked (C2 feeds from it)
!CVE_UPDATES.log
# Generated AI exploits are tracked; secrets are not
!data/exploits/generated/*.py

# Packaging outputs (produced by core.builder / build_widget.py on demand)
resources/tvreaper.apk
resources/tvreaper.wgt
resources/tvreaper.ipk

# Agent / tooling state (never tracked)
.mimosa/
.v2c/
.video_agent/
.zcode/
.zcodeignore
*.mimosa*

# Electron C2 wrapper (deps + build output are regenerated)
electron/node_modules/
electron/dist/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Release APK is a generated asset (create_apk.py builds it on demand)
SpyTV.apk
*.iml
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp
*.swo
*~

# Secrets
*.key
*.crt
*.pem
.env
c2_data/ai_keys.json
