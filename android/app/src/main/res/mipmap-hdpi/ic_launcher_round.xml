<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy round launcher icon for API 24-25 (adaptive-icon requires v26).
     The foreground PNG is pre-clipped to an antialiased circle, so the oval
     background only shows through at the very edge instead of leaving square
     navy corners on a round launcher. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/background"/>
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_round_foreground"/>
</layer-list>
