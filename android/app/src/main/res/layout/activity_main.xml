<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- WebView for C2 Dashboard -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Error view for Console mode -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0E14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F3F4F6"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/errorDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:textColor="#9CA3AF"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:typeface="monospace" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Retry" />

            <Button
                android:id="@+id/btnAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="C2 address" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mode indicator (top-left) -->
    <TextView
        android:id="@+id/modeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#151B27"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="SELF-HOSTED MODE"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Server status (top-right) -->
    <LinearLayout
        android:id="@+id/serverStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="#151B27"
        android:visibility="gone">

        <TextView
            android:id="@+id/serverStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="C2 Server starting..."
            android:textColor="#F3F4F6"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/serverToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Self-Hosted"
            android:textColor="#F3F4F6"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Settings button (top-right corner) -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#151B27"
        android:contentDescription="Settings"
        android:minWidth="0dp"
        android:padding="10dp"
        android:text="⚙"
        android:textColor="#3B82F6"
        android:textSize="16sp" />

    <!-- Mode Selection Buttons (bottom of screen) -->
    <LinearLayout
        android:id="@+id/modeSelectionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Countdown alert text -->
        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="Self-Hosted C2 will start in 3 seconds..."
            android:textColor="#10B981"
            android:textSize="14sp"
            android:background="#151B27"
            android:padding="8dp" />

        <!-- Two buttons at the bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelfHosted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#10B981"
                android:text="Self-Host C2"
                android:textColor="#F3F4F6" />

            <Button
                android:id="@+id/btnConnectRemote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#3B82F6"
                android:text="Remote-Connect C2"
                android:textColor="#F3F4F6" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
