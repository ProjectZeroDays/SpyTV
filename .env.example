# SpyTV C2 secrets — copy to .env and fill in. Do NOT commit .env.
# run_c2.bat checks this file first; if no keys are present it will ask
# which providers you want to configure (or let you skip).

# OpenRouter — Uncensored model
OPENROUTER_API_KEY=

# Venice AI — models: Uncensored V 1.2, Qwen 3.6 Plus Uncensored, GLM 4.7 Flash Heretic
VENICE_API_KEY=

# Abliteration.ai — Abliterated Large v2
ABLITERATION_API_KEY=

# Optional: NVD API key (raises NVD rate limits for the CVE feed)
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Local model (keyless) — GGUF via llama.cpp `llama-server`, or Apple MLX via
# `mlx_lm.server`. No API key: the C2 probes the endpoint and only uses this
# provider while a server answers.
# ---------------------------------------------------------------------------
# OpenAI-compatible endpoint (leave empty for the default shown below):
LOCAL_LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
# Model id sent in requests (server-side models are usually ignored):
LOCAL_LLM_MODEL=local-model
